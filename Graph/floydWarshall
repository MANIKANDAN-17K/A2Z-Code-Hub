class Solution {
    public void floydWarshall(int[][] dist) {
        int n = dist.length;
        for(int i = 0;i<n;i++){
            for(int j = 0;j<n;j++){
                for(int k = 0;k<n;k++){
                    if(dist[j][i] == 1e8 || dist[i][k] == 1e8) continue;
                    if(dist[j][k] == 1e8){
                        dist[j][k] = dist[j][i] + dist[i][k];
                    }else{
                        dist[j][k] = Math.min(dist[j][k],dist[j][i]+dist[i][k]);
                    }
                }
            }
        }
    }
}
